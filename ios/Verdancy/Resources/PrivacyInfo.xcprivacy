<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Verdancy does not track users: no ad SDK, no IDFA, no cross-app tracking.
	     Funnel analytics are on-device only and never leave the device. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- The binding data-collection declaration is the App Store Connect privacy
	     questionnaire (email for sign-in, purchases via RevenueCat, plant photos
	     sent for identify/diagnose). Left empty here; SDKs declare their own. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!-- Required-reason API usage. UserDefaults holds only this app's own settings
	     (appearance, first-run, reported milestones); reason CA92.1. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
